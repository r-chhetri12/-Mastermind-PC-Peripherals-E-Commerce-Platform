@* @model IEnumerable<MasterMind.Models.Product>

<section class="py-5">
	<div class="container px-4 px-lg-5 mt-5">
		<h2 class="text-center mb-5">🕹️ Explore Our Products</h2>

		<div class="row d-flex align-items-start">
			<!-- Filter Sidebar -->
			<div class="col-md-3 mb-4">
				<h5>Filter by Category</h5>
				<ul class="list-group mb-3">
					@foreach (var category in ViewBag.Categories as List<Category>)
					{
						<li class="list-group-item">
							<input type="checkbox" class="category-filter" value="@category.Id" /> @category.Name
						</li>
					}
				</ul>

				<h5>Sort by</h5>
				<select id="sort-options" class="form-select">
					<option value="default">Sort by</option>
					<option value="price-asc">Price: Low to High</option>
					<option value="price-desc">Price: High to Low</option>
				</select>
			</div>

			<!-- Product Grid -->
			<div class="col-md-9">
				<div class="container-fluid service py-5">
					<div class="container py-5">
						<div class="row g-4 justify-content-center" id="product-grid">
							@foreach (var product in Model)
							{
								<div class="col-md-6 col-lg-4">
									<!-- Ensures 3 products per row -->
									<div class="service-item rounded">
										<div class="service-img rounded-top">
											<img src="@product.Image" class="img-fluid rounded-top w-100" alt="@product.Name">
										</div>
										<div class="service-content rounded-bottom bg-light p-4">
											<div class="service-content-inner text-center">
												<h5 class="mb-3 fw-bolder">@product.Name</h5>
												<p class="mb-2">₹@product.Price</p>

												@if (product.Quantity == 0)
												{
													<span class="badge bg-danger">Out of Stock</span>
												}
												else
												{
													<span class="badge bg-success">In Stock: @product.Quantity</span>
												}

												<div class="mt-3">
													<a href="@Url.Action("Details", "Home", new { id = product.Id })" class="btn btn-primary rounded-pill text-white py-2 px-4 mb-2">View</a>

													@if (product.Quantity == 0)
													{
														<button class="btn btn-outline-dark rounded-pill py-2 px-4" disabled>Out of Stock</button>
													}
													else
													{
														<a href="@Url.Action("AddToCart", "ShoppingCart", new { productId = product.Id })" class="btn btn-outline-dark rounded-pill py-2 px-4">Add to Cart</a>
													}
												</div>
											</div>
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

</section>



@section Scripts {
	<script>
				$(document).ready(function () {
			function filterAndSortProducts() {
				var selectedCategories = $(".category-filter:checked").map(function () {
					return $(this).val();
				}).get();

				var sortOption = $("#sort-options").val();

				$.ajax({
					url: "/Home/FilterProducts",
					type: "GET",
					traditional: true,
					data: { categoryIds: selectedCategories, sortOption: sortOption },
					success: function (response) {
						$("#product-grid").html(response); // Ensure correct replacement
					},
					error: function (xhr, status, error) {
						console.error("AJAX Error:", status, error);
					}
				});
			}

			$(".category-filter").on("change", filterAndSortProducts);
			$("#sort-options").on("change", filterAndSortProducts);
		});
	</script	<input type="text" id="productSearch" class="form-control w-25" placeholder="🔍 Search by Product Name..." />>
} *@
@*  SELECT Name, Quantity FROM Products;

  UPDATE Products SET Quantity = 10 WHERE Quantity = 0; *@
  @model IEnumerable<MasterMind.Models.Product>

<section class="py-5">
	<div class="container px-4 px-lg-5 mt-5">
		<h2 class="text-center mb-5" style="color: #0072ff;">🕹️ Explore Our Products</h2>
	
		<div class="row">
			<!-- Filter Sidebar -->
			<div class="col-md-3 mb-4">
				<div class="bg-light p-3 rounded shadow-sm">
					<h5 class="mb-3" style="color: #0072ff;">Filter by Category</h5>
					<ul class="list-group mb-3">
						@foreach (var category in ViewBag.Categories as List<Category>)
						{
							<li class="list-group-item border-0 bg-transparent">
								<input type="checkbox" class="category-filter me-2" value="@category.Id" /> @category.Name
							</li>
						}
					</ul>
					<h5 class="mb-3" style="color: #0072ff;">Sort by</h5>
					<select id="sort-options" class="form-select">
						<option value="default">Sort by</option>
						<option value="price-asc">Price: Low to High</option>
						<option value="price-desc">Price: High to Low</option>
					</select>
				</div>
			</div>

			<!-- Product Grid -->
			<div class="col-md-9">
				<div class="row g-4 justify-content-center" id="product-grid">
					@foreach (var product in Model)
					{
						<div class="col-md-6 col-lg-4">
							<div class="card h-100 product-card border-0 shadow-sm">
								<!-- Product image -->
								<img class="card-img-top" src="@product.Image" alt="@product.Name" style="object-fit: cover; height: 200px;" />
								<!-- Product details -->
								<div class="card-body p-4">
									<div class="text-center">
										<h5 class="fw-bolder" style="color: #0072ff;">@product.Name</h5>
										<p class="mb-1" style="font-size: 1.1rem; color: #555;">₹@product.Price</p>
										@if (product.Quantity == 0)
										{
											<span class="badge bg-danger">Out of Stock</span>
										}
										else
										{
											<span class="badge bg-success">In Stock: @product.Quantity</span>
										}
									</div>
								</div>
								<!-- Product actions -->
								<div class="card-footer p-4 pt-0 text-center d-flex flex-column gap-2 bg-white">
									<a href="@Url.Action("Details", "Home", new { id = product.Id })" class="btn btn-primary rounded-pill py-2 px-4">View</a>
									@if (product.Quantity == 0)
									{
										<button class="btn btn-outline-dark rounded-pill py-2 px-4" disabled>Out of Stock</button>
									}
									else
									{
										<a href="@Url.Action("AddToCart", "ShoppingCart", new { productId = product.Id })" class="btn btn-outline-dark rounded-pill py-2 px-4">Add to Cart</a>
									}
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<script>
		$(document).ready(function () {
			function filterAndSortProducts() {
				var selectedCategories = $(".category-filter:checked").map(function () {
					return $(this).val();
				}).get();

				var sortOption = $("#sort-options").val();

				$.ajax({
					url: "/Home/FilterProducts",
					type: "GET",
					traditional: true, // Ensures proper serialization of arrays
					data: { categoryIds: selectedCategories, sortOption: sortOption },
					success: function (response) {
						$("#product-grid").html(response);
					},
					error: function (xhr, status, error) {
						console.error("AJAX Error:", status, error);
					}
				});
			}

			$(".category-filter").on("change", filterAndSortProducts);
			$("#sort-options").on("change", filterAndSortProducts);
		});
	</script>
	
}
