	<!-- Carousel End -->
	<!-- static service cards -->
	<div class="container-fluid feature py-5">
		<div class="container py-5">
			<div class="section-title mb-5 wow fadeInUp" data-wow-delay="0.1s">
				<div class="sub-style">
					<h4 class="sub-title px-3 mb-0">Why Choose Us</h4>
				</div>
				<h1 class="display-3 mb-4">Why Choose Us? Get Your Life Style Back</h1>
				<p class="mb-0">"At Mastermind, we offer top-quality laptops and accessories backed by expert service and unbeatable prices. Experience performance, reliability, and support — all in one place."</p>
			</div>
			<div class="row g-4 justify-content-center">
				<!-- 100% Original Products -->
				<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.1s">
					<div class="row-cols-1 feature-item p-4">
						<div class="col-12">
							<div class="feature-icon mb-4">
								<div class="p-3 d-flex align-items-center justify-content-center bg-white rounded">
									<img src="~/images/or.jpeg" alt="Original Products" class="img-fluid" style="width: 60px; height: 60px;">
								</div>
							</div>
							<div class="feature-content d-flex flex-column">
								<h5 class="mb-4">100% Original Products</h5>
								<p class="mb-0">All laptops and accessories are authentic and brand certified.</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Fast Delivery -->
				<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.3s">
					<div class="row-cols-1 feature-item p-4">
						<div class="col-12">
							<div class="feature-icon mb-4">
								<div class="p-3 d-flex align-items-center justify-content-center bg-white rounded">
									<img src="~/images/d1.jpg" alt="Fast Delivery" class="img-fluid" style="width: 60px; height: 60px;">
								</div>
							</div>
							<div class="feature-content d-flex flex-column">
								<h5 class="mb-4">Fast Delivery</h5>
								<p class="mb-0">Swift shipping across the country with real-time tracking.</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Fast Customer Service -->
				<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.5s">
					<div class="row-cols-1 feature-item p-4">
						<div class="col-12">
							<div class="feature-icon mb-4">
								<div class="p-3 d-flex align-items-center justify-content-center bg-white rounded">
									<img src="~/images/customer-care.png" alt="Customer Service" class="img-fluid" style="width: 60px; height: 60px;">
								</div>
							</div>
							<div class="feature-content d-flex flex-column">
								<h5 class="mb-4">Fast Customer Services</h5>
								<p class="mb-0">Friendly support team available for queries and assistance.</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Flexible Payments -->
				<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.7s">
					<div class="row-cols-1 feature-item p-4">
						<div class="col-12">
							<div class="feature-icon mb-4">
								<div class="p-3 d-flex align-items-center justify-content-center bg-white rounded">
									<img src="~/images/pay.jpg" alt="Flexible Payments" class="img-fluid" style="width: 60px; height: 60px;">
								</div>
							</div>
							<div class="feature-content d-flex flex-column">
								<h5 class="mb-4">Flexible Payments</h5>
								<p class="mb-0">Multiple payment modes including EMI, UPI, and Cards.</p>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>


	<div class="container-fluid about bg-light py-5">
		<div class="container py-5">
			<div class="row g-5 align-items-center">
				<div class="col-lg-5 wow fadeInLeft" data-wow-delay="0.2s">
					<div class="about-img pb-5 ps-5">
						<img src="~/images/Pb16.png" class="img-fluid rounded w-100" style="object-fit: cover;" alt="Image">
						<div class="about-img-inner">
						</div>
						<div class="about-experience">15 years experience</div>
					</div>
				</div>
				<div class="col-lg-7 wow fadeInRight" data-wow-delay="0.4s">
					<div class="section-title text-start mb-5">
						<h4 class="sub-title pe-3 mb-0">Featured Products</h4>
						<h1 class="display-3 mb-4">BestSelling Product of the Month</h1>
						<p class="mb-4">Lyne Power Box 16 is the ultimate charging solution for all your devices, combining power, speed, and portability in one sleek unit. With multiple USB ports and fast-charging support, it ensures your gadgets are always ready to go. Its compact yet durable design makes it perfect for both travel and daily use. Trusted by hundreds of customers, it’s known for consistent performance and safety features. Whether you're a gamer, traveler, or tech enthusiast, the Lyne Power Box 16 is your perfect power companion. No wonder it’s our Best Seller of the Month!</p>
						<div class="mb-4">
							<p class="text-secondary">
								<i class="fa fa-check text-primary me-2"></i> Output: 4 USB ports with 3.1A fast-charging support

							</p>
							<p class="text-secondary">
								<i class="fa fa-check text-primary me-2"></i>Capacity: 16000mAh high-density lithium battery

							</p>
							<p class="text-secondary">
								<i class="fa fa-check text-primary me-2"></i>Features: Smart protection chipset, LED power indicator, compact design

							</p>
						</div>
						<a href="/Home/Details/30" class="btn btn-primary rounded-pill text-white py-3 px-5">Discover More</a>
					</div>
				</div>
			</div>
		</div>
	</div>


	<!-- Services Start -->
	<div class="container-fluid service py-5">
		<div class="container py-5">
			<div class="section-title mb-5 wow fadeInUp" data-wow-delay="0.2s">
				<div class="sub-style">
					<h4 class="sub-title px-3 mb-0">Latest Products</h4>
				</div>
				<div>
					<h4 class="display-3 mb-4">All new Products From each Segment</h4>
				</div>
			</div>
		</div>

		<div class="row g-4 justify-content-center">
			
			<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.1s">
				<div class="service-item rounded  ">
					<div class="service-img rounded-top">
						<img src="~/images/h2.png" class="img-fluid rounded-top w-100" alt="Boat Rockerz 650">
					</div>
					<div class="service-content rounded-bottom bg-light p-4">
						<div class="service-content-inner">
							<h5 class="mb-4">Boat Rockerz 650</h5>
							<p class="mb-4">
								
								Immerse yourself in thumping bass and crisp audio with up to 60 hours of playback.
								Ergonomic design and dual EQ modes make it perfect for all-day listening.
							</p>
							<a asp-controller="Home" asp-action="Products" class="btn btn-primary rounded-pill text-white py-2 px-4 mb-2">Read More</a>
						</div>
					</div>
				</div>
			</div>

			
			<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.3s">
				<div class="service-item rounded ">
					<div class="service-img rounded-top">
						<img src="~/images/OLed Laptops.png" class="img-fluid rounded-top w-100" alt="Oled Laptops">
					</div>
					<div class="service-content rounded-bottom bg-light p-4">
						<div class="service-content-inner">
							<h5 class="mb-4">Oled Laptops</h5>
							<p class="mb-4">
								
								@* Experience stunning visuals with ultra-deep blacks and vibrant colors, perfect for creative professionals and binge-watchers alike. *@
								Experience stunning visuals with vibrant colors and deep blacks, all thanks to the OLED display. With long battery life and sleek design, it's perfect for work, play, and everything in between.
							</p>
							<a asp-controller="Home" asp-action="Products" class="btn btn-primary rounded-pill text-white py-2 px-4 mb-2">Read More</a>
						</div>
					</div>
				</div>
			</div>

			
			<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.5s">
				<div class="service-item rounded  ">
					<div class="service-img rounded-top">
						<img src="~/images/ROG Swift Pro PG248QP.png" class="img-fluid rounded-top w-100" alt="ROG Swift Pro">
					</div>
					<div class="service-content rounded-bottom bg-light p-4">
						<div class="service-content-inner">
							<h5 class="mb-4">ROG Swift Pro </h5>
							<p class="mb-4">
								
								@* Engineered for esports, the ROG Swift Pro offers lightning-fast refresh rates and ultra-low response times. *@
								Dominate every game with ultra-fast refresh rates and pro-grade precision. The ROG Swift Pro delivers smooth gameplay and razor-sharp visuals for the ultimate competitive edge.
							</p>
							<a asp-controller="Home" asp-action="Products" class="btn btn-primary rounded-pill text-white py-2 px-4 mb-2">Read More</a>
						</div>
					</div>
				</div>
			</div>

			
			<div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.7s">
				<div class="service-item rounded ">
					<div class="service-img rounded-top">
						<img src="~/images/rtx5070.png" class="img-fluid rounded-top w-100" alt="RTX 5070">
					</div>
					<div class="service-content rounded-bottom bg-light p-4">
						<div class="service-content-inner">
							<h5 class="mb-4">RTX 5070</h5>
							<p class="mb-4">	
								Unlock next-gen gaming with real-time ray tracing and AI-powered DLSS performance.
								The RTX 5070 delivers ultra-smooth 4K gameplay and content creation .
							</p>
							<a asp-controller="Home" asp-action="Products" class="btn btn-primary rounded-pill text-white py-2 px-4 mb-2">Read More</a>
						</div>
					</div>
				</div>
			</div>


		</div>
		<br />
		<div class="col-12 text-center wow fadeInUp" data-wow-delay="0.2s">
			<a class="btn btn-primary rounded-pill text-white py-3 px-5" asp-controller="Home" asp-action="Products">View All Products</a>
		</div>
	</div>
