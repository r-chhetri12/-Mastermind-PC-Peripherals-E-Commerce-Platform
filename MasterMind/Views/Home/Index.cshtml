	<style>
		.brand-logo {
			max-height: 120px; /* reduced height */
			object-fit: fill;
			width: auto;
			max-width: 100%;
			margin: 0 auto;
			display: block;
		}
	</style>

	<div class="container-fluid testimonial py-5 wow zoomInDown" data-wow-delay="0.1s">
		<div class="container py-3">
			<!-- Section Title -->
			<div class="section-title mb-4 text-center">
				<div class="sub-style">
					<h4 class="sub-title text-white px-3 mb-0">Our Partners</h4>
				</div>
				<h2 class="display-5 mb-4">Trusted by Leading Brands</h2>
			</div>

			<!-- Brand Images Row -->
			<div class="row justify-content-center align-items-center text-center">
				<!-- First Row: 3 Images -->
				<div class="col-6 col-md-4 mb-4">
					<img src="~/images/Asus-Logo-1995.png" alt="Asus" class="img-fluid brand-logo shadow rounded">
				</div>
				<div class="col-6 col-md-4 mb-4">
					<img src="~/images/acer.png" alt="Acer" class="img-fluid brand-logo shadow rounded">
				</div>
				<div class="col-6 col-md-4 mb-4">
					<img src="~/images/lenlogo.jpg" alt="Lenovo" class="img-fluid brand-logo shadow rounded">
				</div>

				<!-- Second Row: 3 Images -->
				<div class="col-6 col-md-4 mb-4">
					<img src="~/images/samsunglogo.png" alt="Samsung" class="img-fluid brand-logo shadow rounded">
				</div>
				<div class="col-6 col-md-4 mb-4">
					<img src="~/images/hp.png" alt="HP" class="img-fluid brand-logo shadow rounded">
				</div>
				<div class="col-6 col-md-4 mb-4">
					<img src="~/images/delllogo.png" alt="Dell" class="img-fluid brand-logo shadow rounded">
				</div>
			</div>
		</div>
	</div>
	<!-- Partner Brands Carousel End -->
	<!-- Partner Brands Carousel End -->
	<!-- Partner Brands Carousel End -->
	<!-- Required Scripts -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/owl-carousel/1.3.3/owl.carousel.min.css">
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/owl-carousel/1.3.3/owl.carousel.min.js"></script>

	<script>
		$(document).ready(function () {
			$(".header-carousel").owlCarousel({
				items: 1,
				loop: true,
				autoplay: true,
				autoplayTimeout: 5000,
				animateOut: "fadeOut",
			});
		});

	</script>
	<script>
	$('.testimonial-carousel').owlCarousel({
	loop: true,
	margin: 10,
	nav: true,
	responsive: {
	0: {
	items: 1
	},
	600: {
	items: 2
	},
	1000: {
	items: 4 /* Display 4 images per slide */
	}
	}
	});
	</script>
	




