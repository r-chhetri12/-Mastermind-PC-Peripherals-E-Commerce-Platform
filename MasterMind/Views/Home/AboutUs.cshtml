<!DOCTYPE html>

<html>
<head>

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


	<!-- Google Web Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

	<!-- Icon Font Stylesheet -->
	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

	<!-- Libraries Stylesheet -->
	<link href="~/customerlayout/lib/animate/animate.min.css" rel="stylesheet">
	<link href="~/customerlayout/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">


	<!-- Customized Bootstrap Stylesheet -->
	<link href="~/customerlayout/css/bootstrap.min.css" rel="stylesheet">

	<!-- Template Stylesheet -->
	<link href="~/customerlayout/css/style.css" rel="stylesheet">
</head>

<body>
	<!-- About Start -->

	<div class="container-fluid bg-breadcrumb">
		<div class="container text-center py-5" style="max-width: 900px;">
			<h3 class="text-white display-3 mb-4 wow fadeInDown" data-wow-delay="0.1s" style="visibility: visible; animation-delay: 0.1s; animation-name: fadeInDown;">About Us</h3>
			<ol class="breadcrumb justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s" style="visibility: visible; animation-delay: 0.3s; animation-name: fadeInDown;">
				<li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
				<li class="breadcrumb-item active text-primary"><a asp-controller="Home" asp-action="AboutUs">About Us</a></li>
			</ol>
		</div>
	</div>


	<div class="container-fluid about bg-light py-5">
		<div class="container py-5">
			<div class="row g-5 align-items-center">
				<!-- Left Side: Image & Experience Text -->
				<div class="col-lg-5 wow fadeInLeft d-flex align-items-center" data-wow-delay="0.2s">
					<img src="~/images/Mastermindlogo.jpg" class="img-fluid rounded w-100" style="object-fit: cover;" alt="Tech Store">
				
				</div>


				<!-- Right Side: Text Content -->
				<div class="col-lg-7 wow fadeInRight" data-wow-delay="0.4s">
					<div class="section-title text-start mb-5">
						<h4 class="sub-title pe-3 mb-0 fw-bold">About Us</h4>
						<h1 class="display-3 mb-4 fw-bold">Empowering You with Cutting-Edge Technology</h1>
						<p class="mb-4">
							Welcome to <b>MasterMind Tech</b>, your trusted destination for <b>premium laptops and accessories</b>.
							With over <b>15 years of industry expertise</b>, we bring you top-tier brands like
							<b>ASUS, Dell, Lenovo, Samsung, and NVIDIA</b>, ensuring you stay ahead in the world of technology.
						</p>
						<div class="mb-4">
							<p class="text-secondary"><i class="fa fa-check text-primary me-2"></i> <b>Unmatched expertise</b> in laptop & accessories selection.</p>
							<p class="text-secondary"><i class="fa fa-check text-primary me-2"></i> <b>Trusted partnerships</b> with globally recognized tech brands.</p>
							<p class="text-secondary"><i class="fa fa-check text-primary me-2"></i> <b>Customer-focused service</b> with reliable warranties & support.</p>
						</div>
						<a asp-controller="Home" asp-action="Products" class="btn btn-primary rounded-pill text-white py-3 px-5 fw-bold">Explore Our Products</a>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- About End -->
	
	<div class="container-fluid appointment py-5">
		<div class="container py-5">
			<div class="row g-5 align-items-center">
				<!-- Left Side: Introduction & Image -->
				<div class="col-lg-6 wow fadeInLeft" data-wow-delay="0.2s">
					<div class="section-title text-start">
						<h4 class="sub-title pe-3 mb-0 fw-bold text-primary">Who We Are</h4>
						<h1 class="display-3 mb-4 fw-bold text-dark">Your Destination for Top-Tier Laptops & Accessories</h1>
						<p class="mb-4">
							Welcome to <b>MasterMind Tech</b>, a leading name in <b>premium laptop sales</b> and <b>high-performance accessories</b>.
							We provide <b>cutting-edge technology</b> tailored for <span class="text-primary fw-bold">business professionals</span>,
							<span class="text-primary fw-bold">students</span>, and <span class="text-primary fw-bold">gamers</span>.
						</p>
						<p>
							Our goal is to bring <b>innovation, affordability, and expert recommendations</b> to help you find the
							<b>perfect tech solutions</b>. With <b>strong brand partnerships</b>, we offer the <b>latest gadgets and accessories</b>,
							ensuring optimal performance.
						</p>

						<div class="row g-4">
							<div class="col-sm-6">
								<div class="d-flex flex-column h-100">
									<div class="mb-4">
										<h5 class="mb-3 text-dark fw-bold"><i class="fa fa-check text-primary me-2"></i> High-Quality Technology</h5>
										<p class="mb-0 text-secondary">
											Our laptops and accessories meet <b>industry standards</b> for
											<b>performance, reliability, and durability</b>.
										</p>
									</div>
									<div class="mb-4">
										<h5 class="mb-3 text-dark fw-bold"><i class="fa fa-check text-primary me-2"></i> Trusted By Professionals & Gamers</h5>
										<p class="mb-0 text-secondary">
											From <b>gaming setups</b> to <b>business workstations</b>, we ensure
											every device matches your needs.
										</p>
									</div>
									<div class="text-start mb-4">
										<a asp-controller="Home" asp-action="ContactUs" class="btn btn-primary rounded-pill text-white py-3 px-5 fw-bold">
											Get In Touch
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Right Side: Laptops & Accessories -->
				<div class="col-lg-6 wow fadeInRight" data-wow-delay="0.4s">
					<div class="appointment-form rounded p-5">
						<h4 class="sub-title pe-3 mb-0 fw-bold text-primary">Our Exclusive Tech Collection</h4>
						<br /><br />
						<!-- Laptops -->
						<div class="card shadow-sm border-0 mb-4">
							<div class="card-body">
								<h3 class="section-header"><i class="icon fas fa-laptop"></i> Laptops</h3>
								<ul class="list-group list-group-flush">
									<li class="list-group-item">💻 <strong>Gaming Laptops:</strong> High-refresh-rate displays with powerful GPUs for top-tier gaming.</li>
									<li class="list-group-item">📈 <strong>Business Laptops:</strong> Sleek, fast, and reliable machines designed for professional efficiency.</li>
									<li class="list-group-item">🎓 <strong>Student-Friendly Laptops:</strong> Affordable options with great battery life for coursework and multitasking.</li>
									<li class="list-group-item">🌟 <strong>Premium Ultrabooks:</strong> Slim, stylish, and ultra-powerful devices for seamless computing.</li>
								</ul>
							</div>
						</div>

						<!-- Accessories -->
						<div class="card shadow-sm border-0">
							<div class="card-body">
								<h3 class="section-header"><i class="icon fas fa-headphones"></i> Accessories</h3>
								<ul class="list-group list-group-flush">
									<li class="list-group-item">🔋 <strong>Laptop Chargers & Power Banks:</strong> Dependable power solutions to keep your device running.</li>
									<li class="list-group-item">⌨️ <strong>Keyboards & Mice:</strong> High-performance peripherals for precision and speed.</li>
									<li class="list-group-item">🎒 <strong>Laptop Bags & Cooling Pads:</strong> Protect your device and optimize temperature control.</li>
									<li class="list-group-item">🔊 <strong>Headphones & Speakers:</strong> Crystal-clear audio for immersive experiences.</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Trusted Partners Section -->
	<div class="container-fluid my-5">
		<!-- Full-width container -->
		<div class="p-5 bg-light rounded shadow-sm text-center wow fadeInUp" data-wow-delay="0.4s">
			<h2 class="text-primary mb-3">Our Trusted Partners</h2>
			<p>We proudly collaborate with world-renowned tech brands, ensuring top-quality products from industry leaders:</p>

			<!-- Logos Section -->
			<div class="d-flex justify-content-center gap-5 mt-5 flex-wrap">
				<!-- Logos now retain their original sizes -->
				<img src="~/images/Asus-Logo-1995.png" alt="ASUS" class="img-fluid" style="max-width: 230px; height: 200px">
				<img src="~/images/delllogo.jpg" alt="Dell" class="img-fluid" style="max-width: 150px; height: 150px;">
				<img src="~/images/lenlogo.jpg" alt="Lenovo" class="img-fluid" style="max-width: 200px; height: 150px;">
				<img src="~/images/samsung.png" alt="Samsung" class="img-fluid" style="max-width: 200px; height: 150px;">
				<img src="~/images/nvidia.png" alt="NVIDIA" class="img-fluid" style="max-width: 200px; height: 150px;">
			</div>

			<p class="mt-4">
				By partnering with these top-tier brands, we ensure our customers get cutting-edge laptops and accessories that redefine performance and reliability.
			</p>
		</div>
	</div>
</body>

</html>