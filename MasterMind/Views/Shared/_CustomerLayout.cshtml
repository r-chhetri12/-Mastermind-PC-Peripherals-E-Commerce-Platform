@using MasterMind.StaticData
<!DOCTYPE html>

<html>
<head>

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

	<meta charset="utf-8">
	<title>MasterMind Godhra </title>
	<meta content="width=device-width, initial-scale=1.0" name="viewport">
	<meta content="" name="keywords">
	<meta content="" name="description">

	<!-- Google Web Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

	<!-- Icon Font Stylesheet -->
	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

	<!-- Libraries Stylesheet -->
	<link href="~/customerlayout/lib/animate/animate.min.css" rel="stylesheet">
	<link href="~/customerlayout/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">


	<!-- Customized Bootstrap Stylesheet -->
	<link href="~/customerlayout/css/bootstrap.min.css" rel="stylesheet">

	<!-- Template Stylesheet -->
	<link href="~/customerlayout/css/style.css" rel="stylesheet">
</head>
<body>
	<!-- Spinner Start -->
	<div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
		<div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
			<span class="sr-only">Loading...</span>
		</div>
	</div>
	<!-- Spinner End -->
	<!-- Topbar Start -->
	<div class="container-fluid bg-dark px-5 d-none d-lg-block">
		<div class="row gx-0 align-items-center" style="height: 45px;">
			<div class="col-lg-8 text-center text-lg-start mb-lg-0">
				<div class="d-flex flex-wrap">
					<a asp-controller="Home" asp-action="ContactUs" class="text-light me-4">
						<i class="fas fa-map-marker-alt text-primary me-2"></i>Find Our Location
					</a>
					<a class="text-light me-4"><i class="fas fa-phone-alt text-primary me-2"></i>6352522036</a>
				</div>
			</div>
			<div class="col-lg-4 text-center text-lg-end">
				<div class="d-flex align-items-center justify-content-end">
					<a href="#" class="btn btn-light btn-square border rounded-circle nav-fill me-3"><i class="fab fa-facebook-f"></i></a>
					<a href="#" class="btn btn-light btn-square border rounded-circle nav-fill me-3"><i class="fab fa-twitter"></i></a>
					<a href="#" class="btn btn-light btn-square border rounded-circle nav-fill me-3"><i class="fab fa-instagram"></i></a>
					<a href="#" class="btn btn-light btn-square border rounded-circle nav-fill me-0"><i class="fab fa-linkedin-in"></i></a>
				</div>
			</div>
		</div>
	</div>
	<!-- Topbar End -->


	<header>
		<div class="container-fluid position-relative p-0">
			<nav class="navbar navbar-expand-lg navbar-light bg-light px-4 px-lg-5 py-3 py-lg-0">
				<a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center">
					<img src="~/images/Master.jpg" alt="MasterMind Logo" class="img-fluid" style="height: 2.5em;">
					<h1 class="text-primary m-0 ms-2">MasterMind</h1>
				</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
				aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse px-5" id="navbarNav">
					<ul class="navbar-nav me-auto">
						<!-- Pushes nav items left -->
						<li class="nav-item">
							<a class="nav-link text-dark fw-semibold @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark fw-semibold @(ViewContext.RouteData.Values["action"].ToString() == "AboutUs" ? "active" : "")" asp-controller="Home" asp-action="AboutUs">About</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark fw-semibold @(ViewContext.RouteData.Values["action"].ToString() == "Products" ? "active" : "")" asp-controller="Home" asp-action="Products">Products</a>
						</li>
						
						
							<li class="nav-item">
								<a class="nav-link text-dark fw-semibold @(ViewContext.RouteData.Values["action"].ToString() == "ContactUs" ? "active" : "")" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
							</li>
						
						@if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
						{
							<li class="nav-item">
								<a class="nav-link text-dark fw-semibold" asp-controller="ShoppingCart" asp-action="MyOrders">My Orders</a>
							</li>
						}
						@if (User.IsInRole(SD.Role_Admin))
						{
							<li class="nav-item">
								<a class="nav-link fw-semibold" asp-area="Dashboard" asp-controller="Products" asp-action="Index">
									Dashboard
								</a>

							</li>
						}
						

						@if (User.IsInRole(SD.Role_Customer))
						{
							<li class="nav-item">
								<a class="nav-link fw-semibold" asp-area="" asp-controller="ShoppingCart" asp-action="Cart">
									🛒

								</a>
							</li>
						}
					</ul>
					<partial name="_LoginPartial">
				</div>
			</nav>
		</div>
	</header>



	<div>
		<main role="main" class="pb-5">
			@RenderBody()
		</main>
	</div>

	<!-- Footer Start -->
	<div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
		<div class="container py-5">
			<div class="row g-5">
				<div class="col-md-6 col-lg-6 col-xl-3">
					<div class="footer-item d-flex flex-column">
						<h4 class="text-white mb-4">
							<img src="~/images/Master.jpg" alt="MasterMind Logo" class="img-fluid" style="height: 1.5em;">
							MasterMind
						</h4>
						<p>
							"MasterMind Tech – Your trusted source for premium laptops and accessories, delivering innovation and reliability for businesses, gamers, and students."
						</p>
						<div class="d-flex align-items-center">
							<i class="fas fa-share fa-2x text-white me-2"></i>
							<a class="btn-square btn btn-primary text-white rounded-circle mx-1" href=""><i class="fab fa-facebook-f"></i></a>
							<a class="btn-square btn btn-primary text-white rounded-circle mx-1" href=""><i class="fab fa-twitter"></i></a>
							<a class="btn-square btn btn-primary text-white rounded-circle mx-1" href=""><i class="fab fa-instagram"></i></a>
							<a class="btn-square btn btn-primary text-white rounded-circle mx-1" href=""><i class="fab fa-linkedin-in"></i></a>
						</div>
					</div>
				</div>
				<div class="col-md-6 col-lg-6 col-xl-3">
					<div class="footer-item d-flex flex-column">
						<h4 class="mb-4 text-white">Quick Links</h4>
						<a asp-controller="Home" asp-action="AboutUs"><i class="fas fa-angle-right me-2"></i> About Us</a>
						<a asp-controller="Home" asp-action="ContactUs"><i class="fas fa-angle-right me-2"></i> Contact Us</a>
						<a asp-controller="Home" asp-action="Products"><i class="fas fa-angle-right me-2"></i> Browse Products</a>

						

					</div>
				</div>
				<div class="col-md-6 col-lg-6 col-xl-3">
					<div class="footer-item d-flex flex-column">
						<h4 class="mb-4 text-white">MasterMind Services</h4>
						<a ><i class="fas fa-angle-right me-2"></i> 100% Original Products</a>
						<a ><i class="fas fa-angle-right me-2"></i> Fast Delivery</a>
						<a ><i class="fas fa-angle-right me-2"></i> Daily Updates</a>
						<a ><i class="fas fa-angle-right me-2"></i> Fast Customer Services</a>
						
					</div>
				</div>
				<div class="col-md-6 col-lg-6 col-xl-3">
					<div class="footer-item d-flex flex-column">
						<h4 class="mb-4 text-white">Contact Info</h4>
						<a href=""><i class="fa fa-map-marker-alt me-2"></i> Shop No G/1, Mahavir Complex, Opp. China Town, Jain Society, Raykar Apartment, Godhra, Gujarat 389001</a>
						<a href=""><i class="fas fa-envelope me-2"></i> mastermind@gmail.com</a>
					
						<a href=""><i class="fas fa-phone me-2"></i> 6352522036</a>
						<a href="" class="mb-3"><i class="fas fa-print me-2"></i> +012 345 67890</a>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Footer End -->
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<!-- jQuery -->
	@*    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false) *@
	<!-- JavaScript Libraries -->
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/customerlayout/lib/wow/wow.min.js"></script>
	<script src="~/customerlayout/lib/easing/easing.min.js"></script>
	<script src="~/customerlayout/lib/waypoints/waypoints.min.js"></script>
	<script src="~/customerlayout/lib/owlcarousel/owl.carousel.min.js"></script>


	<!-- Template Javascript -->
	<script src="~/CustomerLayout/js/main.js"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
