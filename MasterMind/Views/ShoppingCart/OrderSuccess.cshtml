@{
    ViewData["Title"] = "Order Success";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}


    <link rel="stylesheet" href="~/css/success.css" />


<div class="success-container text-center">
    <div class="checkmark-circle">
        <i class="bi bi-check-circle-fill"></i>
    </div>
    <h2 class="mt-3">Thank You for Your Order!</h2>
    <p class="lead">Your order was placed successfully.</p>

    <div class="order-actions mt-4">
        <a href="@Url.Action("MyOrders", "ShoppingCart")" class="btn btn-outline-primary">View My Orders</a>
        <a href="@Url.Action("Products", "Home")" class="btn btn-primary ms-2">Continue Shopping</a>
    </div>
</div>

<a asp-controller="Home" asp-action="Index" onclick="clearCart()" class="btn btn-primary">
    Go to Home
</a>

<script>
    function clearCart() {
        fetch('/Cart/ClearCart', { method: 'POST' })
            .then(response => {
                if (!response.ok) {
                    console.error('Failed to clear the cart');
                }
            })
            .catch(error => console.error('Error:', error));
    }
</script>
