@model MasterMind.Models.UserProfile
@{
    ViewData["Title"] = "Checkout";
}

<style>
    body {
        background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        backdrop-filter: blur(15px);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
        padding: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.18);
        transition: transform 0.3s ease-in-out;
    }

        .glass-card:hover {
            transform: scale(1.02);
        }

    .form-control,
    .btn {
        border-radius: 12px;
    }

    .btn-success {
        background: linear-gradient(135deg, #00c9ff, #92fe9d);
        color: #000;
        font-weight: bold;
        transition: all 0.3s ease-in-out;
        border: none;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #92fe9d, #00c9ff);
            box-shadow: 0 0 15px rgba(146, 254, 157, 0.5);
            transform: translateY(-2px);
        }

    label {
        font-weight: 500;
    }

    .order-summary li {
        background-color: rgba(255, 255, 255, 0.05);
        border: none;
        border-radius: 12px;
        margin-bottom: 10px;
        padding: 10px 15px;
        transition: background-color 0.3s;
    }

        .order-summary li:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

    h2, h4, h5 {
        color: #fff;
    }

    input::placeholder {
        color: #ccc;
    }

    .total-highlight {
        color: #92fe9d;
        font-size: 1.5rem;
        font-weight: bold;
    }
</style>

<div class="container py-5">
    <h2 class="text-center mb-5">🛒 Secure Checkout</h2>

    <div class="row g-5">
        <!-- Shipping Info -->
        <div class="col-lg-6">
            <div class="glass-card">
                <h4 class="mb-4">Shipping Details</h4>
                <form asp-action="PlaceOrder" method="post">
                    <div class="mb-3">
                        <label>Full Name</label>
                        <input type="text" class="form-control" name="Name" value="@Model.Name" required>
                    </div>
                    <div class="mb-3">
                        <label>Phone Number</label>
                        <input type="tel" class="form-control" name="PhoneNumber" value="@Model.PhoneNumber" required>
                    </div>
                    <div class="mb-3">
                        <label>Address</label>
                        <input type="text" class="form-control" name="Address" value="@Model.Address" required>
                    </div>
                    <div class="mb-3">
                        <label>City</label>
                        <input type="text" class="form-control" name="City" value="@Model.City" required>
                    </div>
                    <div class="mb-3">
                        <label>State</label>
                        <input type="text" class="form-control" name="State" value="@Model.State" required>
                    </div>
                    <div class="mb-3">
                        <label>Pincode</label>
                        <input type="text" class="form-control" name="Pincode" value="@Model.Pincode" required>
                    </div>
                    <button type="button" id="rzp-button1" class="btn btn-success w-100 mt-3">
                        <i class="bi bi-lightning-charge-fill me-2"></i> Make Payment

                    </button>
                </form>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-6">
            <div class="glass-card">
                <h4 class="mb-4">Order Summary</h4>

                @* Razor Logic Block *@
                @{
                    decimal totalPrice = 0;

                    foreach (var item in ViewBag.CartItems)
                    {
                        totalPrice += item.Product.Price * item.Quantity;
                    }

                    decimal delivery = 0;
                    decimal totalAmount = totalPrice + delivery;
                }

                <ul class="list-group order-summary mb-4">
                    @foreach (var item in ViewBag.CartItems)
                    {
                        decimal itemTotal = item.Product.Price * item.Quantity;

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">@item.Product.Name</h6>
                                <small>Qty: @item.Quantity</small>
                            </div>
                            <span class="text-end fw-bold">₹@itemTotal</span>
                        </li>
                    }
                </ul>

                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal:</span>
                    <span>₹@totalPrice</span>
                </div>

                <div class="d-flex justify-content-between mb-2 text-primary">
                    <span>Delivery Charges</span>
                    <span>Free</span>
                </div>

                <hr class="border-light" />

                <div class="d-flex justify-content-between align-items-center pt-3 fw-bold text-white">
                    <span class="fs-5">Total Amount:</span>
                    <span class="total-highlight fs-5">₹@totalAmount</span>
                </div>
            </div>
        </div>


<!-- Optional: Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    var options = {
        "key": "rzp_test_LXtmp0k538yHVA",
        "amount": "@(ViewBag.TotalAmount * 100)", // Convert to paise
        "currency": "INR",
        "name": "MasterMind",
        "description": "Test Transaction",
        "image": "/path/to/logo.png",
        "order_id": "@ViewBag.OrderId", // ✅ Ensure this is set correctly
        "handler": function (response) {
            $.post("/ShoppingCart/CompletePayment", {
                paymentId: response.razorpay_payment_id,
                orderId: response.razorpay_order_id, // ✅ Ensure this is passed
                signature: response.razorpay_signature
            }, function () {
                window.location.href = "/ShoppingCart/OrderSuccess";
            });
        },
        "prefill": {
            "name": "@Model.Name",
            "contact": "@Model.PhoneNumber"
        },
        "theme": {
            "color": "#F37254"
        }
    };

    var rzp1 = new Razorpay(options);
    document.getElementById('rzp-button1').onclick = function (e) {
        rzp1.open();
        e.preventDefault();
    }
</script>
