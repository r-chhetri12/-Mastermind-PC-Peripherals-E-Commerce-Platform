@model List<MasterMind.Models.ShoppingCart>

<style>
    body {
        background: linear-gradient(135deg, #1e1f26, #2c3e50);
        color: #fff;
    }

    .card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        border-radius: 1rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .card-header {
        background-color: rgba(0, 123, 255, 0.8);
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        color: #fff;
    }

    .btn-custom {
        border-radius: 30px;
        padding: 6px 16px;
        transition: all 0.3s ease-in-out;
    }

        .btn-custom:hover {
            transform: scale(1.05);
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
        }

    .text-light-gray {
        color: #ccc;
    }

    img {
        border-radius: 8px;
    }

    a.btn-danger:hover {
        background-color: #ff4d4d;
    }

    a.btn-success:hover {
        background-color: #4CAF50;
    }
</style>

<section class="py-5">
    <div class="container">
        <h2 class="mb-4 text-center text-white fw-bold">🛒 Your Shopping Cart</h2>

        @if (!Model.Any())
        {
            <p class="text-center fs-5 text-light-gray">Your cart is empty.</p>
        }
        else
        {
            <div class="row">
                <!-- Left: Cart Items -->
                <div class="col-md-8">
                    @foreach (var item in Model)
                    {
                        <div class="card mb-4 p-3">
                            <div class="row g-0">
                                <!-- Image -->
                                <div class="col-md-3 d-flex align-items-center justify-content-center bg-dark rounded-start">
                                    <img src="@item.Product.Image" alt="@item.Product.Name" class="img-fluid" style="max-height: 100px;">
                                </div>

                                <!-- Details -->
                                <div class="col-md-9">
                                    <div class="p-3">
                                        <h5 class="text-white">@item.Product.Name</h5>
                                        <div class="d-flex justify-content-between mb-2 text-light-gray">
                                            <span><strong>Price:</strong> ₹@item.Product.Price</span>
                                            <span><strong>Total:</strong> ₹@(item.Product.Price * item.Quantity)</span>
                                        </div>

                                        <!-- Quantity with + / - buttons -->
                                        <div class="d-flex align-items-center mb-3">
                                            <label class="me-2"><strong>Quantity:</strong></label>

                                            <form asp-action="DecreaseQuantity" asp-controller="ShoppingCart" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm px-2 btn-custom">−</button>
                                            </form>

                                            <span class="mx-3 fw-bold text-white">@item.Quantity</span>

                                            <form asp-action="IncreaseQuantity" asp-controller="ShoppingCart" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-success btn-sm px-2 btn-custom">+</button>
                                            </form>
                                        </div>

                                        <div class="d-flex gap-2">
                                            
                                            <a class="btn btn-danger btn-sm btn-custom" href="@Url.Action("RemoveFromCart", "ShoppingCart", new { id = item.Id })">REMOVE</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Right: Price Summary -->
                <div class="col-md-4">
                    <div class="card shadow-sm p-3">
                        <div class="card-header text-white fw-bold">
                            💰 PRICE DETAILS
                        </div>
                        <div class="card-body">
                            @{
                                decimal totalPrice = Model.Sum(i => i.Product.Price * i.Quantity);
                                decimal delivery = 0;
                                decimal totalAmount = totalPrice + delivery;
                            }

                            <div class="d-flex justify-content-between mb-2 text-white">
                                <span>Price (@Model.Count item@((Model.Count > 1) ? "s" : ""))</span>
                                <span>₹@totalPrice</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2 text-primary">
                                <span>Delivery Charges</span>
                                <span>Free</span>
                            </div>

                            <hr class="border-light" />
                            <div class="d-flex justify-content-between fw-bold mb-2 text-white">
                                <span>Total Amount</span>
                                <span>₹@totalAmount</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Bottom Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("ClearCart", "ShoppingCart")" class="btn btn-outline-danger btn-custom">
                    🧹 Clear Cart
                </a>
                <a href="@Url.Action("Checkout", "ShoppingCart")" class="btn btn-success btn-custom">
                    ✅ Proceed to Checkout
                </a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            var message = '@TempData["CartMessage"]';
            var type = '@TempData["CartMessageType"]' || 'success';

            if (message) {
                toastr[type](message);
            }

            // Add other scripts here if needed
        });
    </script>
}

