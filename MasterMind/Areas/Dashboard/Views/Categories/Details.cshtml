@model MasterMind.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-5">
    <div class="card shadow-lg border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="fw-bold"><i class="fas fa-info-circle"></i> Category Details</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-info text-center">
                <h5 class="fw-bold"><i class="fas fa-tag"></i> @Model.Name</h5>
            </div>

            <div class="d-flex justify-content-center mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
