@model MasterMind.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white text-center">
            <h3 class="fw-bold"><i class="fas fa-trash-alt"></i> Delete Category</h3>
        </div>
        <div class="card-body text-center">
            <h5 class="text-danger fw-bold">Are you sure you want to delete this category?</h5>
            <p class="text-muted">This action cannot be undone.</p>

            <div class="alert alert-warning mt-3">
                <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Category: <span class="fw-bold">@Model.Name</span></h5>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger px-4">
                    <i class="fas fa-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">
                    <i class="fas fa-arrow-left"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-danger').hover(function () {
                $(this).toggleClass('btn-outline-danger');
            });
        });
    </script>
}
