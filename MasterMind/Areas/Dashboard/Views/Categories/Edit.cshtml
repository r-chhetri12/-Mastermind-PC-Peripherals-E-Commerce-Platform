@model MasterMind.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-primary text-white text-center py-3 rounded-top">
            <h3 class="fw-bold"><i class="fas fa-edit"></i> Edit Category</h3>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <!-- Category Name -->
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold text-dark">Category Name</label>
                    <input asp-for="Name" class="form-control border-2 border-primary shadow-sm rounded-3" placeholder="Enter category name" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-center gap-4 mt-4">
                    <button type="submit" class="btn btn-success px-5 py-2 shadow-lg fw-bold">
                        <i class="fas fa-save"></i> Save
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2 shadow-lg fw-bold">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
