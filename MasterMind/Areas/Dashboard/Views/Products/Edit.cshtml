@model MasterMind.Models.Product

@{
    ViewData["Title"] = "Edit";
}


<hr />
<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-primary text-white text-center py-3 rounded-top">
            <h3 class="fw-bold"><i class="fas fa-edit"></i> Edit Product</h3>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <!-- Product Name -->
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold text-dark">Product Name</label>
                    <input asp-for="Name" class="form-control border-2 border-primary shadow-sm rounded-3" placeholder="Enter product name" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold text-dark">Description</label>
                    <textarea asp-for="Description" class="form-control border-2 border-primary shadow-sm rounded-3" rows="3" placeholder="Enter product description" required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <label class="form-label">Specifications</label>

                <!-- Quill Editor Container -->
                <div id="editor" style="height: 200px;"></div>

                <!-- Hidden Textarea to Store JSON -->
                <textarea asp-for="Specification" id="Specification" class="form-control" hidden></textarea>

                <small class="text-muted">
                    Enter specifications in Bullet Points.
                </small>

                <!-- Price -->
                <div class="mb-4">
                    <label asp-for="Price" class="form-label fw-semibold text-dark">Price</label>
                    <input asp-for="Price" type="number" class="form-control border-2 border-primary shadow-sm rounded-3" placeholder="Enter price" required />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <!-- Category Dropdown -->
                <div class="mb-4">
                    <label asp-for="CategoryId" class="form-label fw-semibold text-dark">Category</label>
                    <select asp-for="CategoryId" class="form-control border-2 border-primary shadow-sm rounded-3" asp-items="ViewBag.CategoryId" required>
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>


                <div class="form-group">
                    <label asp-for="Quantity" class="control-label"></label>
                    <input asp-for="Quantity" class="form-control" placeholder="Enter quantity" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>



                <!-- Image Upload -->
                <div class="mb-4">
                    <label asp-for="Image" class="form-label fw-semibold text-dark">Upload Image</label>
                    <input type="file" name="Image" class="form-control border-2 border-primary shadow-sm rounded-3" />
                    <span asp-validation-for="Image" class="text-danger small"></span>
                </div>

                <!-- Image Preview -->
                <div class="text-center my-4">
                    <img src="@Model.Image" alt="Product Image" class="img-thumbnail shadow-sm" style="max-width: 250px;" />
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-center gap-4 mt-4">
                    <button type="submit" class="btn btn-success px-5 py-2 shadow-lg fw-bold">
                        <i class="fas fa-save"></i> Save
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2 shadow-lg fw-bold">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const quill = new Quill('#editor', {
          theme: 'snow',
          formats: ['bold', 'italic', 'list', 'bullet', 'ordered'],
        });

        quill.on("text-change", function () {
            var quillHtml = quill.root.innerHTML; // Get full HTML including <ol> and <li> tags
            $("#Specification").val(quillHtml); // Store in hidden field for form submission
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var specInput = document.getElementById("Specification");

            // Load existing data into Quill if available
            if (specInput.value.trim()) {
                quill.root.innerHTML = specInput.value; // Load saved HTML content into Quill
            }

            // Sync Quill content to hidden textarea before form submission
            document.querySelector("form").addEventListener("submit", function () {
                specInput.value = quill.root.innerHTML; // Store Quill content with <ol> and <li> tags
            });
        });
    </script>

    <script>
        document.querySelector("form").addEventListener("submit", function () {
            document.getElementById("Specification").value = quill.root.innerHTML.trim();
        });
    </script>



}
