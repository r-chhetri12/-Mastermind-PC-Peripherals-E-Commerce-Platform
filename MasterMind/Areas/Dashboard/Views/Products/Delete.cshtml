@model MasterMind.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white text-center">
            <h3 class="fw-bold"><i class="fas fa-trash-alt"></i> Delete Product</h3>
        </div>

        <div class="card-body">
            <h4 class="text-center text-danger">Are you sure you want to delete this product?</h4>
            <hr />

            <dl class="row">
                <!-- Product Name -->
                <dt class="col-sm-3 fw-bold">Product Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                <!-- Description -->
                <dt class="col-sm-3 fw-bold">Description</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                <!-- Price -->
                <dt class="col-sm-3 fw-bold">Price</dt>
                <dd class="col-sm-9">₹ @Html.DisplayFor(model => model.Price)</dd>

                <!-- Product Image -->
                <dt class="col-sm-3 fw-bold">Product Image</dt>
                <dd class="col-sm-9">
                    <img src="@Model.Image" alt="Product Image" class="rounded shadow" style="max-width: 200px;">
                </dd>
            </dl>

            <form asp-action="Delete" class="text-center mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4">
                    <i class="fas fa-trash-alt"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">
                    <i class="fas fa-arrow-left"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>
