@model MasterMind.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="font-weight-bold m-0">Add New Product</h3>
           
        </div>
       
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Product Name -->
                        <div class="form-group">
                            <label asp-for="Name" class="control-label font-weight-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        <div class="form-group">
                            <label asp-for="Description" class="control-label font-weight-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter product description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <label class="form-label">Specifications</label>

                        <!-- Quill Editor Container -->
                        <div id="editor" style="height: 200px;"></div>

                        <!-- Hidden Textarea to Store JSON -->
                        <textarea asp-for="Specification" id="Specification" class="form-control" hidden></textarea>

                        <small class="text-muted">
                            Enter specifications in Bullet Points.
                        </small>

                        <!-- Price -->
                        <div class="form-group">
                            <label asp-for="Price" class="control-label font-weight-bold"></label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Enter price" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <!-- Category Dropdown -->
                        <div class="form-group">
                            <label asp-for="CategoryId" class="control-label font-weight-bold">Category</label>
                            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Quantity" class="control-label"></label>
                            <input asp-for="Quantity" class="form-control" placeholder="Enter quantity" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>


                        <!-- Image Upload -->
                        <div class="form-group">
                            <label asp-for="Image" class="control-label font-weight-bold"></label>
                            <input type="file" name="Image" class="form-control" id="imageUpload" />
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>
                        
                        <!-- Image Preview -->
                        <div class="text-center my-3">
                            <img id="previewImage" src="#" alt="Product Image Preview" style="max-width: 200px; display: none;" class="rounded shadow">
                        </div>

                        <!-- Submit Button -->
                        <div class="text-center">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-plus-circle"></i> Add Product
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const quill = new Quill('#editor', {
          theme: 'snow',
          formats: ['bold', 'italic', 'list', 'bullet', 'ordered'],
        });

        quill.on("text-change", function () {
            var quillHtml = quill.root.innerHTML; // Get full HTML including <ol> and <li> tags
            $("#Specification").val(quillHtml); // Store in hidden field for form submission
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var descriptionInput = document.getElementById("Specification");

            // Load existing data into Quill if available
            if (descriptionInput.value.trim()) {
                quill.root.innerHTML = descriptionInput.value; // Load the HTML content into the editor
            }

            // Sync Quill content to textarea before form submission
            document.querySelector("form").addEventListener("submit", function () {
                descriptionInput.value = quill.root.innerHTML; // Save Quill content with <ol> and <li> tags
            });
        });
    </script>



    <script>
        document.getElementById("imageUpload").addEventListener("change", function(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var preview = document.getElementById("previewImage");
                preview.src = reader.result;
                preview.style.display = "block";
            };
            reader.readAsDataURL(event.target.files[0]);
        });
    </script>
 

}
