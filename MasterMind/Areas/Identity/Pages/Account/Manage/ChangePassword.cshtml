@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}


@{
    Layout = "~/Areas/Identity/Pages/Account/Manage/_ManageNav.cshtml";
    <!-- Fixed Layout Path -->
}

@if (!string.IsNullOrEmpty(Model?.StatusMessage))
{
    var statusMessageClass = Model.StatusMessage.StartsWith("Error") ? "danger" : "success";
    var icon = statusMessageClass == "danger" ? "bi-x-circle" : "bi-check-circle";

    <div class="alert alert-@statusMessageClass d-flex align-items-center alert-dismissible fade show shadow-sm p-2 small position-absolute" role="alert" id="status-alert" style="top: 20px; left: 50%; transform: translateX(-50%); z-index: 1050; max-width: 300px;">
        <i class="bi @icon me-2"></i>
        <div class="flex-grow-1">@Model.StatusMessage</div>
    </div>
}

<!-- Page Content -->
<div class="container">
    <h2 class="text-center my-4 fw-bold text-primary">Change Password</h2>
    <hr class="mx-auto mb-4" style="width: 60%;">

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body p-4">
                    <form id="change-password-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.OldPassword" class="form-label fw-semibold">Current Password</label>
                            <input asp-for="Input.OldPassword" class="form-control" type="password" />
                            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.NewPassword" class="form-label fw-semibold">New Password</label>
                            <input asp-for="Input.NewPassword" class="form-control" type="password" />
                            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Identity/Account/Manage" class="nav-link text-dark"> ← Back to Manage</a>
                               
                           

                            <button id="change-password-button" type="submit" class="btn btn-primary">
                                💾 Update Password
                            </button>
                        </div>
                    </form>
                    <br />
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
              setTimeout(function () {
            var alert = document.getElementById('status-alert');
            if (alert) {
                alert.classList.add('fade'); // Add fade class to trigger the fade-out effect
                alert.classList.remove('show'); // Removes 'show' class to start fading
                setTimeout(function () {
                    alert.remove(); // Remove the alert element after fading out
                }, 150); // Adjust delay to match Bootstrap's fade transition
            }
        }, 2000); // Delay before fade starts (2 seconds)
    </script>
}



