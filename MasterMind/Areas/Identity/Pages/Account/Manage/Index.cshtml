@page
@model IndexModel
@{
    ViewData["ActivePage"] = ManageNavPages.Index;
}

@{
    ViewData["Title"] = "Manage Profile";
}
@{
    Layout = "~/Areas/Identity/Pages/Account/Manage/_ManageNav.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<h2 class="text-center my-4 fw-bold text-primary">@ViewData["Title"]</h2>
<hr class="mx-auto mb-4" style="width: 60%;">

@if (!string.IsNullOrEmpty(Model?.StatusMessage))
{
    var statusMessageClass = Model.StatusMessage.StartsWith("Error") ? "danger" : "success";
    var icon = statusMessageClass == "danger" ? "bi-x-circle" : "bi-check-circle";

    <div class="alert alert-@statusMessageClass d-flex align-items-center alert-dismissible fade show shadow-sm p-2 small position-absolute" role="alert" id="status-alert" style="top: 20px; left: 50%; transform: translateX(-50%); z-index: 1050; max-width: 300px;">
        <i class="bi @icon me-2"></i>
        <div class="flex-grow-1">@Model.StatusMessage</div>
    </div>
}

<div class="row justify-content-center position-relative" style="z-index: 1;">
    <div class="col-md-6">
        <div class="card shadow rounded-4 border-0">
            <div class="card-body p-4">
                <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Username" class="form-label fw-semibold">Username</label>
                        <input asp-for="Username" class="form-control" disabled />
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Input.PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            ← Back to Home
                        </a>

                        <button id="update-profile-button" type="submit" class="btn btn-primary">
                            💾 Save Changes
                        </button>
                    </div>
                  
                </form>
            </div>
        </div>
    </div>
</div>
<br />
<br />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
   @*  <partial name="_ManageNav" /> *@

    <script>
              setTimeout(function () {
            var alert = document.getElementById('status-alert');
            if (alert) {
                alert.classList.add('fade'); // Add fade class to trigger the fade-out effect
                alert.classList.remove('show'); // Removes 'show' class to start fading
                setTimeout(function () {
                    alert.remove(); // Remove the alert element after fading out
                }, 150); // Adjust delay to match Bootstrap's fade transition
            }
        }, 2000); // Delay before fade starts (2 seconds)
    </script>
}

