@* @page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<div class="container d-flex justify-content-center align-items-center min-vh-100">

    <!----------------------- Login Container -------------------------->

    <div class="row border rounded-5 p-3 bg-white shadow box-area">

        <!--------------------------- Left Box ----------------------------->

        <div class="col-md-6 rounded-4 d-flex justify-content-center align-items-center flex-column left-box" style="background: #103cbe;">
            <div class="featured-image mb-3">
                <img src="~/Images/Static_Images/login-img.jpg" class="img-fluid" style="width: 250px;">
            </div>
            <p class="text-white fs-2" style="font-family: 'Courier New', Courier, monospace; font-weight: 600;">Be Verified</p>
        </div>

        <!-------------------- ------ Right Box ---------------------------->

        <div class="col-md-6 right-box">
            <div class="row align-items-center">
                <div class="header-text mb-4">
                    <h2>Hello</h2>
                    <p>Register Yourself!</p>
                </div>
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="input-group mb-3">
                        <input asp-for="Input.Name" class="form-control form-control-lg bg-light fs-6" autocomplete="username" aria-required="true" placeholder="FullName" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-3">
                        <input asp-for="Input.Email" class="form-control form-control-lg bg-light fs-6" autocomplete="username" aria-required="true" placeholder="Email Address" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-4">
                        <input asp-for="Input.PhoneNumber" class="form-control form-control-lg bg-light fs-6" placeholder="Phone Number" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-3">
                        <input asp-for="Input.Password" class="form-control form-control-lg bg-light fs-6" autocomplete="new-password" aria-required="true" placeholder="Password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg bg-light fs-6" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-4">
                        <input asp-for="Input.Address" class="form-control form-control-lg bg-light fs-6" placeholder="Address" />
                        <span asp-validation-for="Input.Address" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-4">
                        <input asp-for="Input.City" class="form-control form-control-lg bg-light fs-6" placeholder="City" />
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-4">
                        <input asp-for="Input.State" class="form-control form-control-lg bg-light fs-6" placeholder="State" />
                        <span asp-validation-for="Input.State" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-4">
                        <input asp-for="Input.Pincode" class="form-control form-control-lg bg-light fs-6" placeholder="Pincode" />
                        <span asp-validation-for="Input.Pincode" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-4">
                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-control form-control-lg bg-light fs-6" aria-required="true">
                            <option disabled selected>--Select Role--</option>
                        </select>
                    </div>
                    <div class="input-group mb-3">
                        <button id="registerSubmit" type="submit" class="btn btn-lg btn-primary w-100 fs-6">Register</button>
                    </div>
                    @*                     <div class="input-group mb-3">
                        <button class="btn btn-lg btn-light w-100 fs-6"><img src="images/google.png" style="width:20px" class="me-2"><small>Sign In with Google</small></button>
                    </div> 
                    <div class="row">
                        <small><a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-lg btn-outline-warning w-100 fs-6">Already Logged in ?</a></small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
 *@
 @page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
   
}

<style>
    body {
        background: linear-gradient(to right, #00c6ff, #0072ff);
        min-height: 100vh;
    }

    .register-card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        background-color: rgba(255, 255, 255, 0.2); /* semi-transparent card background */
        backdrop-filter: blur(10px);
    }

    .register-left {
        background-color: rgba(255, 255, 255, 0.3);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
    }

        .register-left img {
            width: 100%;
            max-width: 300px;
        }

    .register-right {
        background-color: rgba(255, 255, 255, 0.4);
        padding: 2rem;
    }

    .form-control {
        border-radius: 0.5rem;
    }

    .form-section-title {
        font-weight: 600;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }
</style>

<div style="background-image: url('@Url.Content("~/images/logregi.jpg")'); background-size: cover; background-position: center;">
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="row w-100 register-card">
        <!-- Left Section -->
        <div class="col-md-5 register-left">
            <div>
                <img src="~/images/Mastermindlogo.jpg" alt="Register" />
                <h3 class="text-center mt-4">Join MasterMind</h3>
                <p class="text-center text-muted">Get started with us today!</p>
            </div>
        </div>

        <!-- Right Section -->
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <input asp-for="Input.Name" class="form-control" placeholder="Full Name" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Input.Email" class="form-control" placeholder="Email Address" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone Number" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-control">
                            <option disabled selected>--Select Role--</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Input.Password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <textarea asp-for="Input.Address" class="form-control" placeholder="Address" rows="3" style="resize: vertical;"></textarea>
                        <span asp-validation-for="Input.Address" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <input asp-for="Input.City" class="form-control" placeholder="City" />
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Input.State" class="form-control" placeholder="State" />
                        <span asp-validation-for="Input.State" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Input.Pincode" class="form-control" placeholder="Pincode" />
                        <span asp-validation-for="Input.Pincode" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button id="registerSubmit" type="submit" class="btn btn-primary w-100 btn-lg">Create Account</button>
                </div>

                <div class="text-center mt-3">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-light w-100">Already registered? Login</a>
                </div>
            </form>

    </div>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
